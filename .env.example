# Copie para .env.local (só para rodar no seu computador).
# Na Vercel, APP_PASSWORD você cadastra à mão; o BLOB_READ_WRITE_TOKEN a própria Vercel cria
# quando você conecta o Blob store ao projeto.

# Senha para entrar no app (escolha uma forte: o site é público na internet)
APP_PASSWORD="troque-por-uma-senha-forte"

# Token do Blob store (painel da Vercel > Storage > seu Blob store > aba ".env.local",
# ou rode `vercel env pull .env.local` na pasta do projeto)
BLOB_READ_WRITE_TOKEN=""
